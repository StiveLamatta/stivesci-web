---
import '../styles/global.css';
import '@fontsource/besley/latin-500.css';
import '@fontsource/besley/latin-700.css';
import '@fontsource/literata/latin-400.css';
import '@fontsource/literata/latin-400-italic.css';
import '@fontsource/literata/latin-600.css';
import '@fontsource/stix-two-text/latin-400.css';

import Header from '../components/Header/Header.astro';

interface Props {
    title?: string;
    description?: string;
}

const { title = 'Stive Lamatta | Estudiante de Matemáticas & Desarrollador', description = 'Estudiante de Matemáticas apasionado por la programación, modelado computacional y algoritmos. Creador del visualizador interactivo de Series de Fourier (Epiciclos).' } = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <meta name="theme-color" content="#0c0c0a" />
        <title>{title}</title>
        <meta name="description" content={description} />

        <!-- Ezoic Privacy Scripts (must load before header script) -->
        <script data-cfasync="false" src="https://cmp.gatekeeperconsent.com/min.js" is:inline></script>
        <script data-cfasync="false" src="https://the.gatekeeperconsent.com/cmp.min.js" is:inline></script>
        <!-- Ezoic Header Script -->
        <script async src="//www.ezojs.com/ezoic/sa.min.js" is:inline></script>
        <script is:inline>
            window.ezstandalone = window.ezstandalone || {};
            ezstandalone.cmd = ezstandalone.cmd || [];
        </script>
        <script src="//ezoicanalytics.com/analytics.js" is:inline></script>
    </head>
    <body>
        <a class="skip" href="#contenido">Saltar al contenido</a>
        <Header />
        <slot />
    </body>
</html>

<style>
    .skip {
        position: absolute;
        left: var(--gutter);
        top: 0.75rem;
        z-index: 200;
        transform: translateY(-150%);
        background: var(--trace);
        color: var(--ink);
        padding: 0.7rem 1rem;
        text-decoration: none;
        font-family: var(--font-display);
        font-weight: 700;
    }

    .skip:focus {
        transform: none;
    }
</style>
