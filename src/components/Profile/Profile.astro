        certifLinkView?.classList.add('profile__certifications-image-full');
        certifLinkImg?.classList.add('profile__certifications-link-view-full');
        certifCloseImg.style.display = 'inline-block';
        cuerpo.style.overflow = 'hidden';
    }

    function closeImg() {
        certifLinkView?.classList.add('profile__certifications-img');
        certifLinkView?.classList.remove('profile__certifications-image-full');
        certifLinkImg?.classList.remove('profile__certifications-link-view-full');
        certifCloseImg.style.display = 'none';
        cuerpo.style.overflow = 'auto';
