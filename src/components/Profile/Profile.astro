    }

    .profile__social .fa-github::after {
        position: absolute;
        content: '';
        width: 38px;
        height: 38px;
        top: 3.3%;
        left: 12%;
        background-color: rgb(255, 255, 254);
        border-radius: 50%;
        z-index: -1;
    }

    .profile__social .fa-github:hover {
        transform: scale(1.2);
    }

    .fa-linkedin {
        color: #0b65c3;
        position: relative;
    }

    .profile__social .fa-linkedin::after {
        position: absolute;
        content: '';
        width: 34px;
        height: 34px;
        top: 8%;
        left: 16%;
        background-color: rgb(255, 255, 254);
        border-radius: 10%;
        z-index: -1;
    }

    .fa-x-twitter {
        color: black;
        position: relative;
    }

    .profile__social .fa-x-twitter::after {
        position: absolute;
        content: '';
        width: 9px;
        height: 30px;
        top: 12%;
        left: 42%;
        transform: skew(37deg);
        background-color: rgb(255, 255, 254);
        border-radius: 10%;
        z-index: -1;
    }

    .profile__content-ctv {
        display: flex;
        justify-content: space-evenly;
    }

    .profile__contact {
        font-size: 15px;
        display: flex;
        align-items: center;
        width: 180px;
        height: 30px;
        border: 2px solid rgb(19, 12, 222);
        border-radius: 20px;
        background-color: rgb(116, 255, 232);
        justify-content: space-between;
    }

    .profile__contact:hover .profile__contact-label {
        transform: translate(-10px, 0);
        cursor: default;
    }

    .profile__contact:hover .profile__contact-btn {
        transform: translate(-5px, 0);
        cursor: pointer;
    }

    .profile__contact-label {
        box-sizing: border-box;
        color: rgb(0, 0, 0);
        border-radius: 20px;
        height: 100%;
        display: flex;
        align-items: center;
        background-color: rgb(5, 255, 238);
        font-size: 15px;
        padding: 7px;
        outline: 2px solid rgb(19, 12, 222);
        transition: transform 0.3s;
    }

    .profile__contact-label-text {
        font-weight: bold;
    }

    .profile__contact-btn {
        font-size: 12px;
        font-weight: 700;
        color: rgb(51, 8, 241);
        position: relative;
        right: 5px;
        transition: transform 0.3s;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .profile__cv {
        width: 80px;
        border: 2px solid rgb(19, 12, 222);
        border-radius: 20px;
        text-align: center;
        position: relative;
        z-index: 50;
        overflow: hidden;
        background: rgb(136, 237, 255);
        height: 30px;
        align-items: center;
        justify-content: center;
        display: flex;
    }

    .profile__cv-btn {
        width: 100%;
        transition: transform 0.5s;
        font-weight: bold;
    }

    .profile__cv-btn:hover {
        transform: scale(1.2);
    }

