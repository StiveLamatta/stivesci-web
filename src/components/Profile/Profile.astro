---
import proy from '../../data/proy.json';
import skil from '../../data/skills.json';
import cert from '../../data/certif.json';
const proyectsList = proy;
const pryoNavList = ['all', 'frontend', 'backend', 'mobile-apps', 'data-science', 'ai-automations', 'others'];
const skillsList = skil;
const certList = cert;

// Using simpler order functions for grid if needed, though modern CSS Grid handles a lot of this better
const numColProyList = Math.ceil(proyectsList.length / 2);
const numColCertList = Math.ceil(certList.length / 4);

function getOrderCert(index: number): number {
    return (index + 1) % 4 == 1 || (index + 1) % 4 == 2 ? 2 * Math.floor((index + 1) / 4) + ((index + 1) % 4) : 2 * numColCertList + 2 * Math.floor(index / 4) + ((index % 4) - 1);
}

function getOrderProy(index: number): number {
    return (index + 1) % 2 == 1 ? Math.floor((index + 1) / 2) + 1 : numColProyList + Math.floor((index + 1) / 2);
}
---

<article class="profile prof">
    <section id="h_pf_about-me" class="profile__section">
        <div class="hero glass-panel">
            <div class="hero__avatar-container">
                <div class="hero__avatar-glow"></div>
                <img class="hero__avatar" src="/profile.jpg" alt="Stive Lamatta" />
            </div>

            <div class="hero__content">
                <h3 class="hero__greeting">Welcome I'm</h3>
                <h1 class="hero__name">Stive Lamatta</h1>
                <h2 class="hero__role">Data Scientist & Developer</h2>

                <div class="hero__actions">
                    <div class="hero__socials">
                        <a href="https://github.com/stivesci" target="_blank" rel="noopener noreferrer" aria-label="GitHub"><i class="fa-brands fa-github"></i></a>
                        <a href="https://linkedin.com/in/stivelamatta" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><i class="fa-brands fa-linkedin"></i></a>
                        <a href="https://twitter.com/stivesci" target="_blank" rel="noopener noreferrer" aria-label="Twitter"><i class="fa-brands fa-x-twitter"></i></a>
                    </div>
                    <div class="hero__buttons">
                        <a class="btn-primary" href="mailto:stive@stivesci.com">Contact <i class="fa-solid fa-paper-plane"></i></a>
                        <a class="btn-secondary" href="./cv" target="_blank">CV <i class="fa-solid fa-download"></i></a>
                    </div>
                </div>
            </div>
        </div>

        <div class="about-me glass-panel">
            <h2 class="section-title">Sobre Mí</h2>
            <p>Hola, soy Stive Lamatta, un apasionado por la tecnología y la educación. Me encanta compartir mis conocimientos y aprender de los demás. Siempre dispuesto a afrontar nuevos desafíos tecnológicos creando soluciones eficientes y modernas.</p>
        </div>
    </section>

    <section id="h_pf_skills" class="profile__section">
        <div class="section-header">
            <h2 class="section-title">Skills</h2>
            <div class="section-line"></div>
        </div>

        <div class="skills-grid">
            {
                skillsList.map((sk) => (
                    <div class="skill-category glass-panel">
                        <h3 class="skill-category__title">{sk.categoria}</h3>
                        <div class="skill-category__items">
                            {sk.techs.map((s) => (
                                <div class="skill-pill">
                                    <img src={`${s.image}`} alt={`${s.tech}`} loading="lazy" />
                                    <span>{s.tech}</span>
                                </div>
                            ))}
                        </div>
                    </div>
                ))
            }
        </div>
    </section>

    <section id="h_pf_projects" class="profile__section">
        <div class="section-header">
            <h2 class="section-title">Projects</h2>
            <div class="section-line"></div>
        </div>

        <nav class="projects-nav">
            <ul>
                <li class="profile__nav-projects-li active_nav-proy"><span>All</span></li>
                <li class="profile__nav-projects-li"><span>Frontend</span></li>
                <li class="profile__nav-projects-li"><span>Backend</span></li>
                <li class="profile__nav-projects-li"><span>Mobile Apps</span></li>
                <li class="profile__nav-projects-li"><span>Data Science</span></li>
                <li class="profile__nav-projects-li"><span>AI Automations</span></li>
                <li class="profile__nav-projects-li"><span>Others</span></li>
            </ul>
        </nav>

        {
            pryoNavList.map((p) => (
                <div id={`${p}`} class="projects-list profile__projects-list" style={p == 'all' ? 'display:grid;' : 'display:none;'}>
                    {proyectsList
                        .filter((proy) => proy.categories.includes(p))
                        .map((py, index) => (
                            <div class={`project-card profile__projects-target-${py.id}`} style={`order:${getOrderProy(index)}`}>
                                <div class="project-card__img-container">
                                    <img class="project-card__img" src={`${py.image}`} alt={`${py.title}`} loading="lazy" />
                                    <div class="project-card__overlay">
                                        <a href={`${py.enlace}`} class="btn-primary btn-sm" target="_blank" rel="noopener noreferrer">
                                            <i class="fa-brands fa-github" /> Code
                                        </a>
                                        <a href={`${py.enlace}`} class="btn-secondary btn-sm" target="_blank">
                                            <i class="fa-solid fa-display" /> Preview
                                        </a>
                                    </div>
                                </div>
                                <div class="project-card__content">
                                    <h3 class="project-card__title">{py.title}</h3>
                                    <p class="project-card__desc">{py.description}</p>

                                    <div class="project-card__tech">
                                        {py.technologies.map((tech) => (
                                            <div class="tech-icon-small" title={tech.tech1}>
                                                <img src={`${tech.img}`} alt={`${tech.tech1}`} loading="lazy" />
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        ))}
                </div>
            ))
        }
    </section>

    <section id="h_pf_certifications" class="profile__section">
        <div class="section-header">
            <h2 class="section-title">Certifications</h2>
            <div class="section-line"></div>
        </div>

        <div class="certifications-grid profile__certifications-content">
            {
                certList.map((cert, index) => (
                    <div class="cert-card profile__certifications-content-item" style={`order:${getOrderCert(index)}`}>
                        <div class="profile__certifications-content-all">
                            <div class="cert-card__img-container profile__certifications-content-image profile__certifications-img">
                                <img class="cert-card__img profile__certifications-img-full" src={`${cert.image}`} alt={`${cert.title}`} loading="lazy" />
                            </div>
                            <div class="cert-card__actions profile__certifications-content-links profile__certifications-view">
                                <a class="cert-action-btn profile__certifications-link-view">
                                    <i class="fa-solid fa-eye" />
                                </a>
                                <a class="cert-action-btn profile__certifications-link-page">
                                    <i class="fa-solid fa-arrow-up-right-from-square" />
                                </a>
                            </div>
                        </div>
                    </div>
                ))
            }
            <button class="profile__certifications-close"><i class="fa-solid fa-xmark"></i></button>
        </div>
    </section>
</article>

<style>
    /* Modern Premium Profile Styles */
    .prof {
        width: 100%;
        max-width: 900px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 60px;
        padding-bottom: 60px;
    }

    .profile__section {
        display: flex;
        flex-direction: column;
        gap: 24px;
        scroll-margin-top: 100px; /* For anchor links */
    }

    /* Glass Panel Base */
    .glass-panel {
        background: rgba(15, 20, 35, 0.4);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 24px;
        padding: 40px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
    }

    /* Typography */
    .section-title {
        font-family: 'Lora', serif;
        font-size: 32px;
        font-weight: 700;
        color: #fff;
        margin: 0;
    }

    .section-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 8px;
    }

    .section-line {
        flex: 1;
        height: 1px;
        background: linear-gradient(90deg, rgba(255, 255, 255, 0.2) 0%, transparent 100%);
    }

    /* Buttons */
    .btn-primary,
    .btn-secondary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 24px;
        border-radius: 30px;
        font-weight: 600;
        font-size: 15px;
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        cursor: pointer;
    }

    .btn-primary {
        background: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%);
        color: #000;
        border: none;
        box-shadow: 0 4px 15px rgba(79, 172, 254, 0.4);
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(79, 172, 254, 0.6);
        background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
    }

    .btn-secondary {
        background: rgba(255, 255, 255, 0.05);
        color: #fff;
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .btn-secondary:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: rgba(255, 255, 255, 0.4);
        transform: translateY(-2px);
    }

    .btn-sm {
        padding: 8px 16px;
        font-size: 13px;
    }

    /* Hero Section */
    .hero {
        display: flex;
        align-items: center;
        gap: 40px;
        position: relative;
        overflow: hidden;
    }

    .hero::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle at top left, rgba(79, 172, 254, 0.15), transparent 40%), radial-gradient(circle at bottom right, rgba(161, 140, 209, 0.15), transparent 40%);
        z-index: -1;
        pointer-events: none;
    }

    .hero__avatar-container {
        position: relative;
        width: 180px;
        height: 180px;
        flex-shrink: 0;
    }

    .hero__avatar-glow {
        position: absolute;
        inset: -10px;
        border-radius: 50%;
        background: linear-gradient(135deg, #00f2fe, #f093fb);
        opacity: 0.7;
        filter: blur(15px);
        animation: pulseAvatar 4s infinite alternate;
    }

    @keyframes pulseAvatar {
        0% {
            transform: scale(1);
            opacity: 0.6;
        }
        100% {
            transform: scale(1.05);
            opacity: 0.9;
        }
    }

    .hero__avatar {
        position: relative;
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 50%;
        border: 4px solid rgba(255, 255, 255, 0.2);
        z-index: 1;
    }

    .hero__content {
        display: flex;
        flex-direction: column;
    }

    .hero__greeting {
        font-size: 18px;
        color: rgba(255, 255, 255, 0.7);
        margin: 0 0 4px;
        font-weight: 500;
    }

    .hero__name {
        font-family: 'Lora', serif;
        font-size: 48px;
        font-weight: 800;
        margin: 0 0 8px;
        background: linear-gradient(135deg, #fff 0%, #a1c4fd 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        line-height: 1.1;
    }

    .hero__role {
        font-size: 20px;
        color: #4facfe;
        margin: 0 0 24px;
        font-weight: 500;
    }

    .hero__actions {
        display: flex;
        align-items: center;
        gap: 24px;
        flex-wrap: wrap;
    }

    .hero__socials {
        display: flex;
        gap: 16px;
    }

    .hero__socials a {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.05);
        color: #fff;
        font-size: 20px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        transition: all 0.3s ease;
    }

    .hero__socials a:hover {
        background: #4facfe;
        color: #000;
        border-color: #4facfe;
        transform: translateY(-4px);
        box-shadow: 0 8px 20px rgba(79, 172, 254, 0.4);
    }

    .hero__buttons {
        display: flex;
        gap: 12px;
    }

    .about-me {
        padding: 30px 40px;
    }

    .about-me p {
        color: rgba(255, 255, 255, 0.8);
        font-size: 16px;
        line-height: 1.7;
        margin-top: 16px;
    }

    /* Skills Grid */
    .skills-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 24px;
    }

    .skill-category {
        padding: 24px;
        transition: transform 0.3s ease;
    }

    .skill-category:hover {
        transform: translateY(-4px);
        background: rgba(20, 25, 45, 0.5);
    }

    .skill-category__title {
        font-size: 20px;
        color: #fff;
        margin: 0 0 20px;
        font-weight: 600;
    }

    .skill-category__items {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    .skill-pill {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: rgba(255, 255, 255, 0.9);
        font-size: 14px;
        font-weight: 500;
        transition: all 0.3s ease;
    }

    .skill-pill img {
        width: 18px;
        height: 18px;
        object-fit: contain;
    }

    .skill-pill:hover {
        background: rgba(255, 255, 255, 0.15);
        border-color: rgba(255, 255, 255, 0.3);
        transform: scale(1.05);
    }

    /* Projects Navigation */
    .projects-nav {
        margin-bottom: 10px;
    }

    .projects-nav ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    .profile__nav-projects-li {
        padding: 8px 20px;
        border-radius: 30px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: rgba(255, 255, 255, 0.7);
        font-weight: 500;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.3s ease;
        text-transform: capitalize;
    }

    .profile__nav-projects-li:hover {
        background: rgba(255, 255, 255, 0.1);
        color: #fff;
    }

    .profile__nav-projects-li.active_nav-proy {
        background: linear-gradient(135deg, #00f2fe, #4facfe);
        color: #000;
        border: none;
        box-shadow: 0 4px 15px rgba(79, 172, 254, 0.4);
    }

    /* Projects Grid */
    .projects-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 24px;
    }

    .project-card {
        background: rgba(15, 20, 35, 0.4);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .project-card:hover {
        transform: translateY(-8px);
        border-color: rgba(255, 255, 255, 0.2);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    }

    .project-card__img-container {
        position: relative;
        width: 100%;
        height: 180px;
        overflow: hidden;
        background: #000;
    }

    .project-card__img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.8;
        transition:
            opacity 0.5s ease,
            transform 0.8s ease;
    }

    .project-card:hover .project-card__img {
        opacity: 1;
        transform: scale(1.05);
    }

    .project-card__overlay {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .project-card:hover .project-card__overlay {
        opacity: 1;
    }

    .project-card__content {
        padding: 24px;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .project-card__title {
        font-family: 'Lora', serif;
        font-size: 20px;
        font-weight: 700;
        color: #fff;
        margin: 0 0 12px;
    }

    .project-card__desc {
        font-size: 14px;
        color: rgba(255, 255, 255, 0.7);
        line-height: 1.6;
        margin: 0 0 20px;
        flex: 1;
    }

    .project-card__tech {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        padding-top: 16px;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .tech-icon-small {
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 6px;
        padding: 4px;
    }

    .tech-icon-small img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    /* Certifications Grid */
    .certifications-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 20px;
        position: relative;
    }

    .cert-card {
        position: relative;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.1);
        aspect-ratio: 4/3;
        background: rgba(0, 0, 0, 0.5);
    }

    .cert-card__img-container {
        width: 100%;
        height: 100%;
    }

    .cert-card__img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.7;
        transition: all 0.4s ease;
    }

    .cert-card:hover .cert-card__img {
        opacity: 1;
        transform: scale(1.05);
    }

    .cert-card__actions {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .cert-card:hover .cert-card__actions {
        opacity: 1;
    }

    .cert-action-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(4px);
        color: #fff;
        font-size: 16px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .cert-action-btn:hover {
        background: #4facfe;
        color: #000;
        transform: scale(1.1);
    }

    /* Modal / Full image view state */
    .profile__certifications-image-full {
        position: fixed;
        inset: 0;
        z-index: 999;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.9);
        backdrop-filter: blur(10px);
    }

    .profile__certifications-link-view-full {
        max-width: 90vw;
        max-height: 90vh;
        object-fit: contain;
        border-radius: 12px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    }

    .profile__certifications-close {
        display: none;
        position: fixed;
        top: 24px;
        right: 24px;
        z-index: 1000;
        background: rgba(255, 255, 255, 0.1);
        border: none;
        color: #fff;
        width: 48px;
        height: 48px;
        border-radius: 50%;
        font-size: 24px;
        cursor: pointer;
        transition: all 0.3s;
    }
    .profile__certifications-close:hover {
        background: rgba(255, 255, 255, 0.3);
        transform: rotate(90deg);
    }

    @media (max-width: 768px) {
        .hero {
            flex-direction: column;
            text-align: center;
            gap: 24px;
        }

        .hero__actions {
            justify-content: center;
        }
    }
</style>

<script define:vars={{ proyectsList }}>
    // Project filtering logic
    const contentProy = document.getElementById('h_pf_projects');
    const btnProyBar = document.querySelectorAll('.profile__nav-projects-li');

    if (btnProyBar) {
        btnProyBar.forEach((btn) => {
            btn.addEventListener('click', (event) => {
                let chackClickProy = event.currentTarget.children[0].innerHTML.toLowerCase().replace(' ', '-');
                contentProy.querySelectorAll('.profile__projects-list').forEach((e) => (e.style.display = 'none'));
                const targetList = contentProy.querySelector(`#${chackClickProy}`);
                if (targetList) {
                    targetList.style.display = 'grid';
                    btnProyBar.forEach((b) => b.classList.remove('active_nav-proy'));
                    event.currentTarget.classList.add('active_nav-proy');
                }
            });
        });
    }

    // Certifications modal logic
    const certifLinkViewFull = document.querySelectorAll('.profile__certifications-link-view');
    const certifCloseImg = document.querySelector('.profile__certifications-close');
    const cuerpo = document.querySelector('body');
    let certifLinkView, certifLinkImg, certifParent;

    if (certifLinkViewFull) {
        certifLinkViewFull.forEach((el) => {
            el.addEventListener('click', (event) => {
                certifParent = event.target.closest('.profile__certifications-content-all');
                certifLinkView = certifParent.querySelector('.profile__certifications-content-image');
                certifLinkImg = certifParent.querySelector('.profile__certifications-img-full');

                certifLinkView?.classList.remove('cert-card__img-container');
                certifLinkView?.classList.add('profile__certifications-image-full');
                certifLinkImg?.classList.add('profile__certifications-link-view-full');

                if (certifCloseImg) certifCloseImg.style.display = 'inline-block';
                if (cuerpo) cuerpo.style.overflow = 'hidden';
            });
        });
    }

    if (certifCloseImg) {
        certifCloseImg.addEventListener('click', () => {
            certifLinkView?.classList.add('cert-card__img-container');
            certifLinkView?.classList.remove('profile__certifications-image-full');
            certifLinkImg?.classList.remove('profile__certifications-link-view-full');
            certifCloseImg.style.display = 'none';
            if (cuerpo) cuerpo.style.overflow = 'auto';
        });
    }
</script>
