    .profile__about-me {
        border-radius: 20px;
        display: flex;
        flex-direction: column;
        padding: 20px;
        grid-column: 1 / span 2;
    }

    .profile__skills {
        border-radius: 20px;
        padding: 0px 20px 20px 20px;
        display: flex;
        flex-direction: column;
        height: 504px;
    }

    .profile__skills-head {
        flex: 0.01;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 5px;
    }

    .profile__skills-head h2 {
        margin: 5px 0 0 0;
        font-size: 35px;
        transition: transform 0.3s;
    }

    .profile__skills-head:hover h2 {
        transform: scale(1.2);
        cursor: default;
    }

    .profile__stack {
        border-radius: 20px;
        flex: 0.99;
        display: grid;
        grid-template-columns: repeat(2, 50%);
        grid-template-rows: repeat(2, 50%);
    }

    .profile__stack-category {
        box-sizing: border-box;
        border: 1px solid black;
        box-shadow: 0 0 5px 1px black;
        border-radius: 20px;
        margin: 10px;
        transition: transform 0.3s;
        backdrop-filter: blur(5px);
    }

    .profile__stack-category:hover {
        transform: scale(1.05);
        cursor: default;
    }

    .profile__stack-category-head {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 20%;
    }

    .profile__stack-category-head h2 {
        margin: 0;
        transition: transform 0.3s;
    }

    .profile__stack-category-head:hover h2 {
        transform: scale(1.2);
        cursor: default;
    }

    .profile__stack-category-list {
        list-style-type: none;
        display: flex;
        flex-wrap: wrap;
        height: 80%;
        margin: 0;
        padding: 0;
        align-items: center;
        justify-content: center;
    }

    .profile__stack-category-list-item {
        height: 50px;
        width: 50px;
        margin: 5px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.3s;
    }

    .profile__stack-category-list-item:hover {
        transform: scale(1.3);
    }

    .profile__stack-category-list-item img {
        width: 100%;
        filter: drop-shadow(0px 5px 4px rgba(0, 0, 0, 0.5));
    }

    .profile__st {
        outline: 2px solid rgb(216, 16, 16);
        border-radius: 20px;
    }

    .profile__projects {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        border-radius: 20px;
        height: 550px;
        position: relative;
    }

    .profile__projects-title {
        text-align: center;
        font-size: 35px;
        margin: 5px 0 0 0;
        transition: transform 0.3s;
    }

    .profile__projects-title:hover {
        transform: scale(1.2);
        cursor: default;
    }

    .profile__projects-bar {
        display: flex;
        width: 100%;
    }

    .profile__nav-projects {
        display: flex;
        width: 100%;
        justify-content: flex-end;
    }

    .profile__nav-projects ul {
        display: flex;
        list-style-type: none;
        font-size: 10px;
        width: 100%;
        justify-content: center;
        align-items: center;
        border-radius: 20px;
        margin: 15px;
        padding: 0;
    }

    .profile__nav-projects-li {
        border-radius: 10px;
        box-shadow: 0 0 2px 1px rgb(9, 31, 237);
        padding: 5px 10px;
        text-align: center;
        font-weight: 800;
        font-size: 14px;
        margin: 5px;
        backdrop-filter: blur(5px);
        transition:
            transform 0.3s,
            background-color 0.3s,
            box-shadow 0.3s;
    }

    .profile__nav-projects ul li:hover {
        transform: scale(1);
        background-color: rgb(110, 241, 255);
        box-shadow: 2px 2px 3px 1px rgb(9, 31, 237);
        cursor: pointer;
        z-index: 50;
    }

    .active_nav-proy {
        background-color: rgb(0, 229, 255);
        transform: scale(1.1);
        box-shadow: 2px 2px 3px 1px rgb(9, 31, 237);
    }

    .profile__nav-projects ul li span {
        color: rgb(6, 36, 170);
    }

    .profile__projects-list {
        box-sizing: border-box;
        display: grid;
        grid-template-columns: repeat(4, 100%);
        grid-template-rows: repeat(2, 48%);
        width: 640px;
        border-radius: 10px;
        height: 450px;
        overflow: hidden;
        scroll-behavior: smooth;
        margin: 0;
        padding: 0;
        row-gap: 2%;
    }

    .profile__projects-btn-izq,
    .profile__projects-btn-der {
        position: absolute;
        color: rgb(11, 253, 212);
        background-color: transparent;
        border: none;
        font-size: 60px;
        top: calc(52%);
        cursor: pointer;
        z-index: 1;
        margin: 0;
        padding: 0;
        width: 35px;
        height: 60px;
        border-radius: 20px;
        line-height: 10px;
        animation-duration: 2s;
        animation-iteration-count: infinite;
        animation-direction: alternate;
        transition: background-color 0.3s;
    }

    .profile__projects-btn-izq:hover,
    .profile__projects-btn-der:hover {
        background-image: linear-gradient(to left, rgb(105, 29, 246, 0.5), rgb(153, 3, 160, 0.5));
        box-shadow: 0 0 5px 1px rgb(57, 15, 242);
    }

    .profile__projects-btn-izq {
        left: -7px;
        animation-name: projects-btn-izq;
        background-image: linear-gradient(to right, transparent, rgb(5, 191, 238, 0.8));
    }

    .profile__projects-btn-der {
        right: -7px;
        animation-name: projects-btn-der;
        background-image: linear-gradient(to left, transparent, rgb(5, 191, 238, 0.8));
    }

    @keyframes projects-btn-izq {
        from {
            transform: translate(0, 0);
        }

        to {
            transform: translate(-7px, 0);
        }
    }

    @keyframes projects-btn-der {
        from {
            transform: translate(0, 0);
        }

        to {
            transform: translate(7px, 0);
        }
    }

    .profile__projects-target {
        border-radius: 20px;
        display: flex;
        justify-content: center;
        justify-self: center;
        text-align: center;
        align-items: center;
        align-self: center;
        width: 100%;
        height: 100%;
        gap: 2%;
    }

    .profile__projects-target-img {
        height: 100%; /*80*/
        width: 53%;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
        border-radius: 10px;
    }

    .profile__projects-target-img img {
        height: 100%;
    }

    .profile__projects-target-content {
        display: flex;
        height: 100%; /*80*/
        width: 45%;
        flex-direction: column;
        justify-content: space-between;
        align-items: start;
    }

    .profile__projects-target-description {
        display: flex;
        width: 100%;
        flex-direction: column;
        justify-content: start;
        align-items: start;
    }

    .profile__projects-target-title {
        display: flex;
        justify-content: center;
        width: 100%;
        flex-direction: column;
    }

    .profile__projects-target-title h2 {
        margin: 0;
        font-size: 20px;
        text-align: left;
    }

    .profile__projects-target-title p {
        margin: 0;
        font-size: 15px;
        text-align: left;
    }

    .profile__proy-link-content div {
        display: inline-block;
        margin-right: 7px;
        transition: transform 0.3s;
    }

    .profile__proy-link-content div:hover {
        transform: scale(1.15);
    }

    .profile__proy-link {
        text-decoration: none;
        color: rgb(20, 81, 185);
        font-weight: 800;
        border: 2px solid rgb(20, 81, 185);
        border-radius: 10px;
        padding: 5px 8px;
        background-color: rgba(17, 231, 255, 0.34);
    }

    .profile__projects-target-technologies {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: start;
        width: 100%;
        list-style-type: none;
        padding: 0;
        margin: 0;
    }

    .profile__projects-target-technologies li {
        display: flex;
        width: 40px;
        flex-direction: row;
        justify-content: center;
        align-items: center;
        margin: 0 5px;
        transition: transform 0.2s;
        filter: drop-shadow(0px 0px 5px rgba(23, 20, 234, 0.689));
    }

    .profile__projects-target-technologies li:hover {
        transform: scale(1.3);
        cursor: pointer;
    }

    .profile__projects-target-tech {
        display: flex;
        justify-content: center;
