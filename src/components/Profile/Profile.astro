    const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) {
                active.forEach((ac) => ac.classList.remove('active'));
                console.log('remover');
                const id = entry.target.getAttribute('id');
                console.log('ObtenerID', id);
                const text = document.querySelector(`a[href="#${id}"]`);
                text?.classList.add('active');
                console.log('agregar');
            }
        });
    }, observerOptions);

    sections.forEach((section) => {
        observer.observe(section);
    });

    function moveRight() {
        if (elProyList && elProyList.scrollLeft % 640 == 0) {
            elProyList.scrollLeft += 640;
        }
    }

    function moveLeft() {
        if (elProyList && elProyList.scrollLeft % 640 == 0) {
            elProyList.scrollLeft -= 640;
        }
    }

    function viewFull(event) {
        certifParent = event.target.closest('.profile__certifications-content-all');
        certifLinkView = certifParent.querySelector('.profile__certifications-content-image');
        certifLinkImg = certifParent.querySelector('.profile__certifications-img-full');

