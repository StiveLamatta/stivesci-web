---
import proyList from '../../data/proy.json';
import skillsList from '../../data/skills.json';
import certList from '../../data/certif.json';

const featuredProject = proyList[0];
---

<article class="page">
    <section class="dome" aria-label="Epiciclos">
        <div class="dome__sky">
            <canvas class="dome__canvas" aria-hidden="true"></canvas>
            <p class="sr-only">Animación de un epiciclo: círculos amarillos trazan una curva sobre fondo negro. No es una captura de la aplicación; la captura está en el proyecto.</p>
        </div>
        <div class="program">
            <div class="wrap program__grid">
                <img class="program__portrait" src="/profile.jpg" width="896" height="906" alt="Stive Lamatta" />
                <div class="program__copy">
                    <h1>Stive Lamatta</h1>
                    <p>
                        Apasionado por la intersección entre las <strong>matemáticas puras</strong>, los <strong>algoritmos</strong> y la <strong>computación visual</strong>. Aspirante a Data Science.
                    </p>
                    <a class="action" href="https://epy.stivesci.com" target="_blank" rel="noopener noreferrer">
                        Abrir Epiciclos
                        <span class="sr-only"> (se abre en una pestaña nueva)</span>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <div class="sheet">
        <section id="h_pf_about-me" class="block">
            <div class="wrap prose">
                <h2>Sobre Mí & Enfoque</h2>
                <p>
                    Actualmente soy estudiante universitario de <strong>Matemáticas</strong>. Me fascina descubrir cómo conceptos teóricos abstractos —como el análisis armónico, las series de Fourier, el álgebra lineal o el cálculo diferencial— cobran vida al traducirlos en código y simulaciones interactivas.
                </p>
                <p>
                    No me considero un "senior" que domina todo, sino un <strong>estudiante curioso y perseverante</strong> con sólida base lógica y matemática, que disfruta programar, resolver problemas difíciles y aprender continuamente nuevas herramientas del ecosistema de datos y desarrollo web.
                </p>
            </div>
        </section>

        <section id="h_pf_projects" class="block">
            <div class="wrap">
                <h2>Epiciclos — Visualizador de Series de Fourier</h2>
                <p class="lede">Mi proyecto principal: cómo transformar dibujos y trazos en órbitas de vectores rotatorios complejos calculados matemáticamente.</p>
                <p class="note">La animación del inicio se dibuja en esta página. Esta es una captura de Epiciclos.</p>

                <div class="plate">
                    <figure class="capture">
                        <img src={featuredProject.image} width="426" height="240" alt={featuredProject.title} />
                        <figcaption>{featuredProject.title}</figcaption>
                    </figure>
                    <div class="plate__math">
                        <p class="equation">
                            <span>X<sub>k</sub> = Σ x<sub>n</sub> · e<sup>−i 2π k n / N</sup></span>
                        </p>
                        <p class="tags">Series de Fourier · React 19 · Canvas 60fps · Supabase</p>
                    </div>
                </div>

                <p class="lede">{featuredProject.description}</p>

                <h3>Matemáticas & Algoritmos Implementados</h3>
                <ul class="math">
                    <li>
                        <strong>Transformada Discreta de Fourier (DFT):</strong> Descomposición de la trayectoria en coeficientes armónicos complejos: <em>X<sub>k</sub> = Σ x<sub>n</sub> · e<sup>−i 2π k n / N</sup></em>.
                    </li>
                    <li><strong>Interpolación Spline Catmull-Rom:</strong> Suavizado continuo de puntos para curvas sin quiebres.</li>
                    <li><strong>Cálculo de Baricentro:</strong> Determinación geométrica del centro óptimo de rotación orbital.</li>
                    <li><strong>Renderizado de Video:</strong> Captura de canvas a 60fps con exportación en MP4 y WebM.</li>
                </ul>

                <div class="actions">
                    <a class="action action--trace" href={featuredProject.enlace} target="_blank" rel="noopener noreferrer">
                        Abrir aplicación
                        <span class="sr-only"> (se abre en una pestaña nueva)</span>
                    </a>
                    {
                        featuredProject.github && (
                            <a class="text-link" href={featuredProject.github} target="_blank" rel="noopener noreferrer">
                                Código en GitHub
                                <span class="sr-only"> (se abre en una pestaña nueva)</span>
                            </a>
                        )
                    }
                </div>
            </div>
        </section>

        <section id="h_pf_skills" class="block">
            <div class="wrap">
                <h2>Matemáticas, Lenguajes & Herramientas</h2>
                <p class="lede">Una clasificación honesta de mi formación teórica y las tecnologías con las que trabajo.</p>
                <div class="groups">
                    {
                        skillsList.map((cat) => (
                            <section class="group">
                                <h3>{cat.categoria}</h3>
                                <p class="level">{cat.badge}</p>
                                <p>{cat.description}</p>
                                <ul>
                                    {cat.techs.map((tech) => (
                                        <li>
                                            {tech.isTheoretical ? (
                                                <span class="mark" aria-hidden="true">
                                                    {tech.icon}
                                                </span>
                                            ) : (
                                                <img src={tech.image} alt="" width="20" height="20" />
                                            )}
                                            <span>{tech.tech}</span>
                                        </li>
                                    ))}
                                </ul>
                            </section>
                        ))
                    }
                </div>
            </div>
        </section>

        <section id="h_pf_certifications" class="block">
            <div class="wrap">
                <h2>Certificados & Cursos Aprobados</h2>
                <p class="lede">Diplomas obtenidos en áreas de matemáticas avanzadas, cálculo y estadística. Elige uno para ampliarlo.</p>
                <ul class="certs">
                    {
                        certList.map((cert) => (
                            <li>
                                <button type="button" class="cert" data-img={cert.image} data-title={cert.title}>
                                    <img src={cert.image} alt="" width="320" height="240" />
                                    <span class="cert__text">
                                        <span class="cert__title">{cert.title}</span>
                                        <span class="cert__place">{cert.institution}</span>
                                        <span class="cert__action">Ver diploma</span>
                                    </span>
                                </button>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </section>

        <section id="h_pf_blog" class="block">
            <div class="wrap prose">
                <h2>Blog de Matemáticas & Programación</h2>
                <p class="level">En desarrollo</p>
                <p>
                    Próximamente escribiré artículos explicando de manera intuitiva temas como <strong>series de Fourier aplicadas</strong>, <strong>álgebra lineal computacional</strong>, algoritmos geométricos y proyectos de código.
                </p>
            </div>
        </section>
    </div>

    <section id="h_pf_contact" class="contact">
        <div class="wrap">
            <h2>¿Conversamos sobre algún proyecto o problema matemático?</h2>
            <p>Estoy abierto a oportunidades de pasantías, proyectos colaborativos, contribuciones de código abierto o resolver retos técnicos.</p>
            <a class="contact__mail" href="mailto:stive@stivesci.com">stive@stivesci.com</a>
            <ul class="contact__links">
                <li>
                    <a href="https://linkedin.com/in/stivelamatta" target="_blank" rel="noopener noreferrer">
                        LinkedIn
                        <span class="sr-only"> (se abre en una pestaña nueva)</span>
                    </a>
                </li>
                <li>
                    <a href="https://github.com/stivesci" target="_blank" rel="noopener noreferrer">
                        GitHub
                        <span class="sr-only"> (se abre en una pestaña nueva)</span>
                    </a>
                </li>
            </ul>
        </div>
    </section>
</article>

<dialog id="diploma" class="diploma" aria-labelledby="diploma-titulo">
    <button id="diploma-cerrar" class="diploma__close" type="button">Cerrar</button>
    <img id="diploma-img" src={certList[0].image} alt={`Diploma: ${certList[0].title}`} />
    <p id="diploma-titulo">{certList[0].title}</p>
</dialog>

<style>
    .page {
        width: 100%;
    }

    .wrap {
        width: min(var(--wrap), calc(100% - 2 * var(--gutter)));
        margin-inline: auto;
    }

    .dome {
        display: grid;
        grid-template-rows: minmax(12rem, 1fr) auto;
        min-height: calc(100svh - var(--header-h));
        background: var(--sky);
    }

    .dome__sky {
        position: relative;
        min-height: 12rem;
        background: var(--sky);
    }

    .dome__canvas {
        position: absolute;
        inset: 0;
        display: block;
        width: 100%;
        height: 100%;
    }

    .program {
        background: var(--trace);
        color: var(--ink);
    }

    .program__grid {
        display: grid;
        grid-template-columns: 7.5rem 1fr;
        gap: 1.5rem 1.75rem;
        align-items: center;
        padding-block: 1.5rem 1.75rem;
    }

    .program__portrait {
        width: 7.5rem;
        height: 7.5rem;
        object-fit: cover;
        object-position: center 18%;
        background: var(--ink);
    }

    .program__copy h1 {
        margin: 0;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(2.6rem, 6vw, 4.75rem);
        line-height: 0.92;
        letter-spacing: -0.03em;
        text-wrap: balance;
        color: var(--ink);
    }

    .program__copy p {
        margin: 0.85rem 0 1.1rem;
        max-width: 42rem;
        color: var(--ink);
        font-size: 1.05rem;
        line-height: 1.5;
    }

    .program strong {
        font-weight: 600;
    }

    .action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 2.75rem;
        padding: 0.65rem 1.1rem;
        background: var(--ink);
        color: var(--trace);
        text-decoration: none;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.05rem;
        letter-spacing: -0.01em;
    }

    .action:hover {
        background: #000;
    }

    .action--trace {
        background: var(--trace);
        color: var(--ink);
    }

    .action--trace:hover {
        background: var(--trace-deep);
    }

    .program :focus-visible,
    .contact :focus-visible {
        outline-color: var(--ink);
    }

    .block,
    .contact {
        scroll-margin-top: calc(var(--header-h) + 0.75rem);
    }

    .block {
        padding-top: var(--space-8);
    }

    .block h2,
    .contact h2 {
        margin: 0 0 0.85rem;
        max-width: 22ch;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(2rem, 4.2vw, 3.35rem);
        line-height: 1.02;
        letter-spacing: -0.03em;
        text-wrap: balance;
        color: var(--paper);
    }

    .contact h2 {
        color: var(--ink);
        max-width: 18ch;
    }

    .prose p,
    .lede,
    .group p,
    .note {
        max-width: var(--measure);
    }

    .prose p,
    .lede,
    .group p,
    .math,
    .note,
    .contact p {
        margin: 0 0 1rem;
        font-size: 1.0625rem;
        line-height: 1.65;
        text-wrap: pretty;
    }

    .prose strong,
    .math strong {
        color: var(--paper);
        font-weight: 600;
    }

    .note {
        color: var(--quiet);
    }

    .plate {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(16rem, 0.85fr);
        gap: 1.5rem 2.5rem;
        align-items: center;
        margin: 1.5rem 0 1.75rem;
    }

    .capture {
        margin: 0;
    }

    .capture img {
        display: block;
        width: 100%;
        height: auto;
        background: var(--sky);
    }

    .capture figcaption {
        margin-top: 0.55rem;
        color: var(--quiet);
        font-size: 0.95rem;
    }

    .tags {
        margin: 0;
        color: var(--trace);
        font-family: var(--font-display);
        font-weight: 500;
        font-size: 1rem;
    }

    .equation {
        margin: 0 0 0.85rem;
        color: var(--trace);
        font-family: var(--font-math);
        font-size: clamp(1.35rem, 3vw, 2.35rem);
        line-height: 1.35;
        letter-spacing: -0.02em;
    }

    .equation sub,
    .equation sup {
        font-size: 0.62em;
    }

    .block h3 {
        margin: 1.5rem 0 0.7rem;
        font-family: var(--font-display);
        font-size: 1.35rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--paper);
    }

    .math {
        padding-left: 1.15rem;
        color: var(--body);
    }

    .math li + li {
        margin-top: 0.45rem;
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1.25rem 1.75rem;
        margin-top: 1.75rem;
    }

    .text-link {
        display: inline-flex;
        align-items: center;
        min-height: 2.75rem;
        color: var(--paper);
        font-family: var(--font-display);
        font-weight: 700;
    }

    .action--trace:focus-visible {
        outline-color: var(--paper);
    }

    .groups {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2.75rem 4rem;
        margin-top: 2.25rem;
    }

    .group {
        border-top: 1px solid var(--line);
        padding-top: 1rem;
    }

    .group h3 {
        margin: 0 0 0.35rem;
        max-width: 22ch;
        text-wrap: balance;
    }

    .level {
        margin: 0 0 0.55rem;
        color: var(--trace);
        font-family: var(--font-display);
        font-weight: 500;
        font-size: 0.95rem;
    }

    .group ul {
        list-style: none;
        margin: 1rem 0 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
    }

    .group ul li {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        min-height: 2rem;
        color: var(--paper);
    }

    .group img {
        width: 1.25rem;
        height: 1.25rem;
        object-fit: contain;
    }

    .mark {
        width: 1.7rem;
        flex: none;
        color: var(--trace);
        font-family: var(--font-math);
        font-size: 0.95rem;
    }

    .certs {
        list-style: none;
        margin: 1.75rem 0 0;
        padding: 0;
        border-bottom: 1px solid var(--line);
    }

    .cert {
        width: 100%;
        display: grid;
        grid-template-columns: 8.5rem 1fr;
        gap: 1rem 1.25rem;
        align-items: center;
        padding: 1rem 0;
        border: 0;
        border-top: 1px solid var(--line);
        background: transparent;
        color: inherit;
        text-align: left;
        cursor: pointer;
    }

    .cert img {
        width: 8.5rem;
        height: 6.2rem;
        object-fit: cover;
        background: #1a1a16;
    }

    .cert__text {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
    }

    .cert__title {
        color: var(--paper);
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.2rem;
        letter-spacing: -0.02em;
        line-height: 1.2;
    }

    .cert__place {
        color: var(--quiet);
        font-size: 0.95rem;
    }

    .cert__action {
        margin-top: 0.35rem;
        color: var(--trace);
        font-family: var(--font-display);
        font-weight: 700;
    }

    .cert:hover .cert__title {
        color: var(--trace);
    }

    .contact {
        margin-top: var(--space-8);
        background: var(--trace);
        color: var(--ink);
        padding-block: var(--space-8);
    }

    .contact p {
        max-width: 40rem;
        color: var(--ink);
    }

    .contact__mail {
        display: inline-block;
        margin-top: 0.5rem;
        color: var(--ink);
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(1.6rem, 3vw, 2.4rem);
        letter-spacing: -0.03em;
        line-height: 1.15;
        text-decoration-thickness: 1px;
    }

    .contact__links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
        list-style: none;
        margin: 1.25rem 0 0;
        padding: 0;
    }

    .contact__links a {
        color: var(--ink);
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.15rem;
        min-height: 2.75rem;
        display: inline-flex;
        align-items: center;
    }

    .diploma {
        width: min(52rem, calc(100vw - 2rem));
        max-height: calc(100dvh - 2rem);
        overflow: auto;
        padding: 4rem 1.25rem 1.25rem;
        border: 1px solid var(--line);
        background: var(--plaster);
        color: var(--paper);
    }

    .diploma::backdrop {
        background: rgb(0 0 0 / 72%);
    }

    .diploma img {
        display: block;
        width: 100%;
        max-height: 62dvh;
        object-fit: contain;
        background: #1a1a16;
    }

    .diploma p {
        margin: 0.85rem 0 0;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.15rem;
    }

    .diploma__close {
        position: absolute;
        top: 0.75rem;
        right: 0.75rem;
        min-width: 2.75rem;
        min-height: 2.75rem;
        padding: 0.4rem 0.85rem;
        background: var(--trace);
        color: var(--ink);
        border: 0;
        font-family: var(--font-display);
        font-weight: 700;
        cursor: pointer;
    }

    .diploma__close:hover {
        background: var(--trace-deep);
    }

    @media (max-width: 800px) {
        .plate {
            grid-template-columns: 1fr;
        }

        .groups {
            grid-template-columns: 1fr;
            row-gap: 2rem;
        }

        .program__grid {
            grid-template-columns: 4.75rem 1fr;
            gap: 1rem;
            align-items: start;
        }

        .program__portrait {
            width: 4.75rem;
            height: 4.75rem;
        }

        .program__copy .action {
            width: 100%;
        }

        .cert {
            grid-template-columns: 6.25rem 1fr;
        }

        .cert img {
            width: 6.25rem;
            height: 4.7rem;
        }
    }

    @media (max-width: 420px) {
        .program__grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<script>
    const canvas = document.querySelector('.dome__canvas');
    if (canvas instanceof HTMLCanvasElement) {
        const ctx = canvas.getContext('2d');
        const terms = [
            { amp: 1, freq: 1, phase: 0 },
            { amp: 0.42, freq: -2, phase: 0.55 },
            { amp: 0.2, freq: 3, phase: 1.15 },
            { amp: 0.1, freq: -5, phase: 0.25 },
        ];
        const trace: { x: number; y: number }[] = [];
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let running = true;
        let frame = 0;

        const resize = () => {
            const rect = canvas.getBoundingClientRect();
            const dpr = Math.min(window.devicePixelRatio || 1, 2);
            const width = Math.max(1, Math.floor(rect.width * dpr));
            const height = Math.max(1, Math.floor(rect.height * dpr));
            if (canvas.width !== width || canvas.height !== height) {
                canvas.width = width;
                canvas.height = height;
            }
        };

        const chain = (time: number) => {
            const joints = [{ x: 0, y: 0 }];
            let x = 0;
            let y = 0;
            for (const term of terms) {
                x += term.amp * Math.cos(term.freq * time + term.phase);
                y += term.amp * Math.sin(term.freq * time + term.phase);
                joints.push({ x, y });
            }
            return joints;
        };

        for (let step = 0; step < 900; step += 1) {
            const tip = chain(step / 140).at(-1);
            if (tip) trace.push(tip);
        }

        const draw = (time: number) => {
            if (!ctx) return;
            const width = canvas.width;
            const height = canvas.height;
            if (width < 2 || height < 2) return;
            const unit = Math.min(width, height) * 0.22;
            const cx = width * 0.5;
            const cy = height * 0.52;
            ctx.fillStyle = '#000000';
            ctx.fillRect(0, 0, width, height);

            ctx.beginPath();
            trace.forEach((point, index) => {
                const px = cx + point.x * unit;
                const py = cy + point.y * unit;
                if (index === 0) ctx.moveTo(px, py);
                else ctx.lineTo(px, py);
            });
            ctx.strokeStyle = '#e4f04a';
            ctx.lineWidth = Math.max(1.25, width / 700);
            ctx.lineJoin = 'round';
            ctx.lineCap = 'round';
            ctx.stroke();

            if (reduced) return;

            const joints = chain(time);
            ctx.lineWidth = Math.max(1, width / 1100);
            joints.forEach((joint, index) => {
                if (index === joints.length - 1) return;
                const term = terms[index];
                const next = joints[index + 1];
                const ox = cx + joint.x * unit;
                const oy = cy + joint.y * unit;
                ctx.beginPath();
                ctx.arc(ox, oy, term.amp * unit, 0, Math.PI * 2);
                ctx.strokeStyle = '#e4f04a';
                ctx.stroke();
                ctx.beginPath();
                ctx.moveTo(ox, oy);
                ctx.lineTo(cx + next.x * unit, cy + next.y * unit);
                ctx.strokeStyle = '#f4f0d8';
                ctx.stroke();
            });
        };

        const tick = (now: number) => {
            if (!running) return;
            resize();
            draw(now / 1100);
            frame = requestAnimationFrame(tick);
        };

        resize();
        if (reduced) {
            draw(0);
        } else {
            frame = requestAnimationFrame(tick);
            document.addEventListener('visibilitychange', () => {
                if (document.hidden) {
                    running = false;
                    cancelAnimationFrame(frame);
                } else if (!running) {
                    running = true;
                    frame = requestAnimationFrame(tick);
                }
            });
            const observer = new IntersectionObserver(
                ([entry]) => {
                    if (!entry) return;
                    if (entry.isIntersecting && !running) {
                        running = true;
                        frame = requestAnimationFrame(tick);
                    } else if (!entry.isIntersecting && running) {
                        running = false;
                        cancelAnimationFrame(frame);
                    }
                },
                { threshold: 0.05 }
            );
            observer.observe(canvas);
        }

        window.addEventListener('resize', resize);
    }

    const dialog = document.getElementById('diploma');
    const dialogImg = document.getElementById('diploma-img');
    const dialogTitle = document.getElementById('diploma-titulo');
    const dialogClose = document.getElementById('diploma-cerrar');

    if (dialog instanceof HTMLDialogElement && dialogImg instanceof HTMLImageElement && dialogTitle) {
        document.querySelectorAll<HTMLButtonElement>('.cert').forEach((button) => {
            button.addEventListener('click', () => {
                const src = button.getAttribute('data-img');
                const title = button.getAttribute('data-title') ?? 'Diploma';
                if (!src) return;
                dialogImg.src = src;
                dialogImg.alt = `Diploma: ${title}`;
                dialogTitle.textContent = title;
                dialog.showModal();
            });
        });

        const close = () => dialog.close();

        dialogClose?.addEventListener('click', close);
        dialog.addEventListener('click', (event) => {
            if (event.target === dialog) close();
        });
    }
</script>
