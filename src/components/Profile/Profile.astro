---
import proy from '../../data/proy.json';
import skil from '../../data/skills.json';
import cert from '../../data/certif.json';
const proyectsList = proy;
const pryoNavList = ['all', 'frontend', 'backend', 'mobile-apps', 'data-science', 'ai-automations', 'others'];
const skillsList = skil;
const certList = cert;
const numColProyList = Math.ceil(proyectsList.length / 2);
const numColCertList = Math.ceil(certList.length / 4);

function getOrderCert(index: number): number {
    return (index + 1) % 4 == 1 || (index + 1) % 4 == 2 ? 2 * Math.floor((index + 1) / 4) + ((index + 1) % 4) : 2 * numColCertList + 2 * Math.floor(index / 4) + ((index % 4) - 1);
}

function getOrderProy(index: number): number {
    return (index + 1) % 2 == 1 ? Math.floor((index + 1) / 2) + 1 : numColProyList + Math.floor((index + 1) / 2);
}
---

<article class="profile prof">
    <section id="h_pf_about-me" class="profile__head profile__section">
        <div class="profile__parent">
            <div class="profile__parent-image">
                <img class="profile__image" src="/profile.jpg" alt="Stive Lamatta" />
            </div>
        </div>

        <div class="profile__networks">
            <div class="profile__networks-content">
                <div class="profile__person-info">
                    <h2 class="profile__hello">Welcome I'm</h2>
                    <h2 class="profile__name">Stive Lamatta</h2>
                    <p class="profile__role">Data Scientist & Developer</p>
                </div>
                <div class="profile__center">
                    <div class="profile__social">
                        <a href="https://github.com/stivesci" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
                            <i class="fa-brands fa-github"></i>
                        </a>
                        <a href="https://linkedin.com/in/stivelamatta" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                            <i class="fa-brands fa-linkedin"></i>
                        </a>
                        <a href="https://twitter.com/stivesci" target="_blank" rel="noopener noreferrer" aria-label="Twitter">
                            <i class="fa-brands fa-x-twitter"></i>
                        </a>
                    </div>
                    <div class="profile__content-ctv">
                        <div class="profile__contact">
                            <p class="profile__contact-label"><span class="profile__contact-label-text">Contact</span></p><a class="profile__contact-btn" href="mailto:stive@stivesci.com">stive@stivesci.com</a>
                        </div>
                        <div class="profile__cv">
                            <a class="profile__cv-btn" href="./cv" target="_blank">CV ⬇️</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <section class="profile__about-me">
            <h2>Sobre Mi</h2>
            <p>Hola, soy Stive Lamatta, un apasionado por la tecnología y la educación. Me encanta compartir mis conocimientos y aprender de los demás.</p>
        </section>
    </section>

    <section id="h_pf_skills" class="profile__skills profile__section">
        <div class="profile__skills-head">
            <h2>Skills</h2>
        </div>
        <div class="profile__stack">
            {
                skillsList.map((sk) => (
                    <div class="profile__stack-category">
                        <div class="profile__stack-category-head">
                            <h2>{sk.categoria}</h2>
                        </div>
                        <ul class="profile__stack-category-list">
                            {sk.techs.map((s) => (
                                <li class="profile__stack-category-list-item">
                                    <img src={`${s.image}`} alt={`${s.tech}`} />
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>
    </section>

    <section id="h_pf_projects" class="profile__projects profile__section">
        <h2 class="profile__projects-title">Projects</h2>
        <div class="profile__projects-bar">
            <nav class="profile__nav-projects">
                <ul>
                    <li class="profile__nav-projects-li active_nav-proy">
                        <span>All</span>
                    </li>
                    <li class="profile__nav-projects-li">
                        <span>Frontend</span>
                    </li>
                    <li class="profile__nav-projects-li">
                        <span>Backend</span>
                    </li>
                    <li class="profile__nav-projects-li">
                        <span>Mobile Apps</span>
                    </li>
                    <li class="profile__nav-projects-li">
                        <span>Data Science</span>
                    </li>
                    <li class="profile__nav-projects-li">
                        <span>AI Automations</span>
                    </li>
                    <li class="profile__nav-projects-li">
                        <span>Others</span>
                    </li>
                </ul>
            </nav>
        </div>
        {
            pryoNavList.map((p) => (
                <div id={`${p}`} class="profile__projects-list" style={p == 'all' ? 'display:grid;' : 'display:none;'}>
                    {proyectsList
                        .filter((proy) => proy.categories.includes(p))
                        .map((py, index) => (
                            <div class={`profile__projects-target profile__projects-target-${py.id}`} style={`order:${getOrderProy(index)}`}>
                                <div class="profile__projects-target-img">
                                    <img src={`${py.image}`} alt={`${py.title}`} />
                                </div>
                                <div class="profile__projects-target-content">
                                    <div class="profile__projects-target-description">
                                        <div class="profile__projects-target-title">
                                            <h2>{py.title}</h2>
                                            <p>{py.description}</p>
                                        </div>
                                    </div>
                                    <div class="profile__proy-link-content">
                                        <div>
                                            <a href={`${py.enlace}`} class="profile__proy-link" rel="noopener noreferrer" aria-label="GitHub">
                                                {' '}
                                                <span class="fa-brands fa-github" /> Code
                                            </a>
                                        </div>
                                        <div>
                                            <a href={`${py.enlace}`} class="profile__proy-link">
                                                {' '}
                                                🖥️Preview
                                            </a>
                                        </div>
                                    </div>
                                    <ul class="profile__projects-target-technologies">
                                        {py.technologies.map((tech) => (
                                            <li>
                                                <div class="profile__projects-target-tech">
                                                    <img src={`${tech.img}`} alt={`${tech.tech1}`} />
                                                </div>
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            </div>
                        ))}
                </div>
            ))
        }

        <button class="profile__projects-btn-der"> &gt </button>
        <button class="profile__projects-btn-izq"> &lt </button>
    </section>

    <section id="h_pf_certifications" class="profile__certifications profile__section">
        <div class="profile__certifications-head">
            <h2>Certifications</h2>
        </div>
        <div class="profile__certifications-all">
            <div class="profile__certifications-content">
                {
                    certList.map((cert, index) => (
                        <div class="profile__certifications-content-item" style={`order:${getOrderCert(index)}`}>
                            <div class="profile__certifications-content-all">
                                <div class="profile__certifications-content-image profile__certifications-img">
                                    <img class="profile__certifications-img-full" src={`${cert.image}`} alt={`${cert.title}`} />
                                </div>
                                <div class="profile__certifications-content-links profile__certifications-view">
                                    <a class="profile__certifications-link-view">
                                        <i class="fa-solid fa-eye" />
                                    </a>
                                    <a class="profile__certifications-link-page">
                                        <i class="fa-solid fa-arrow-up-right-from-square" />
                                    </a>
                                </div>
                            </div>
                        </div>
                    ))
                }
                <button class="profile__certifications-close">X</button>
            </div>
            <button class="profile__certifications-btn-der"> &gt </button>
            <button class="profile__certifications-btn-izq"> &lt </button>
        </div>
    </section>

    <section id="h_pf_contact" class="profile__contact-me profile__section">
        <h2>Contact</h2>
        <div class="profile__form-content">
            <form class="profile__form" action="https://formspree.io/f/meerakkb" method="POST">
                <label>
                    <p>Correo</p>
                    <input type="email" name="email" required />
                </label>
                <label>
                    <p>Mensaje</p>
                    <textarea style="resize:none;" name="message" placeholder="✍️Escribeme☺️" required></textarea>
                </label>
                <button> Send 📩</button>
            </form>
        </div>
    </section>
</article>

<style>
    .prof {
        box-sizing: border-box;
        height: 100%;
    }

    .profile__section {
        margin: 50px 0 130px;
        scroll-margin-top: 130px;
        border-radius: 0 !important;
        border-top: 2px solid rgb(8, 35, 210);
    }

    .profile__head {
        display: grid;
        border-radius: 20px;
        height: 570px;
        flex-direction: column;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 285px 285px;
        width: 100%;
        backdrop-filter: blur(5px);
    }

    .profile__parent {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: end;
        width: 100%;
    }

    .profile__parent-image {
        width: 75%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .profile__image {
        width: 100%;
        border-radius: 50%;
        border: 2px solid rgb(19, 12, 222);
        box-shadow: 0 0 15px 1px rgb(36, 112, 244);
    }

    .profile__networks {
        display: flex;
        flex-direction: column;
        width: 100%;
        height: 100%;
        align-items: start;
        justify-content: space-evenly;
    }

    .profile__networks-content {
        display: flex;
        flex-direction: column;
        height: 93.4%;
        width: 286px;
        box-sizing: border-box;
        justify-content: space-between;
    }

    .profile__person-info {
        display: flex;
        width: 100%;
        text-align: center;
        flex-direction: column;
        justify-content: center;
        position: relative;
        margin: 15px 0 0 0;
    }

    .profile__person-info h2,
    .profile__person-info p {
        margin: 0;
    }

    .profile__person-info h2:first-child {
        font-size: 22px;
    }

    .profile__person-info h2:nth-child(2) {
        font-size: 40px;
    }

    .profile__center {
        display: flex;
        flex-direction: column;
        width: 100%;
        height: 120px;
        justify-content: space-between;
    }

    .profile__social {
        width: 100%;
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: center;
        font-size: 40px;
        border-radius: 20px;
        margin-bottom: 20px;
