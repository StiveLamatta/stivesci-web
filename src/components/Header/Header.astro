---

<header class="header">
    <div class="header__top">
        <div class="header__container">
            <div class="header__brand">
                <div class="header__logo">
                    <img src="/logo.jpg" alt="Stive Lamatta" />
                </div>
                <div class="header__info">
                    <h1>StiveSci</h1>
                    <p>Data Scientist & Developer</p>
                </div>
            </div>
            <nav class="header__nav" id="main-nav">
                <div class="header__nav-child">
                    <ul class="header__nav-main">
                        <li>
                            <a href="#w-home"><span class="icon">🏠</span> Home</a>
                        </li>
                        <li>
                            <a href="#w-articulos"><span class="icon">📄</span> Artículos</a>
                        </li>
                        <li>
                            <a href="#w-proyectos"><span class="icon">📁</span> Proyectos</a>
                        </li>
                        <li>
                            <a href="#w-galeria"><span class="icon">🖼️</span> Galería</a>
                        </li>
                        <li>
                            <a href="#w-contacto"><span class="icon">✉️</span> Redes & Contacto</a>
                        </li>
                    </ul>
                </div>
            </nav>
        </div>
        <div class="header__actions">
            <button class="btn-subscribe">¡Suscríbete Gratis!</button>
            <button class="header__menu-toggle" id="menu-toggle" aria-label="Abrir menú">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </div>
    </div>
</header>

<style>
    .header {
        box-sizing: border-box;
        display: flex;
        width: 100%;
        height: 8dvh;
        position: sticky;
        top: 0;
        backdrop-filter: blur(10px);
        border-bottom: 1px solid rgb(9, 33, 153);
        z-index: 70;
    }

    .header__top {
        display: flex;
        width: 100%;
        height: 100%;
    }

    .header__container {
        display: flex;
        width: 100%;
        height: 100%;
    }

    .header__brand {
        display: flex;
        width: 20%;
        height: 100%;
    }

    .header__logo {
        margin-left: 10px;
    }

    .header__logo img {
        width: 55px;
        height: 55px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid var(--primary-color);
    }

    .header__info {
        display: flex;
        flex-direction: column;
        font-size: 10px;
        justify-content: center;
        margin-left: 10px;
        height: 100%;
    }

    .header__info h1 {
        padding: 0;
        margin: 0;
        display: inline-block;
        font-weight: 700;
        letter-spacing: 3px;
        color: rgb(106, 214, 47);
    }

    .header__info p {
        padding: 0;
        margin: 0;
        display: inline-block;
        text-transform: uppercase;
        color: white;
    }

    .header__nav {
        display: flex;
        margin-left: 10px;
        width: 80%;
        height: 100%;
    }

    .header__nav-child {
        display: flex;
        width: 100%;
        align-items: center;
    }

    .header__nav ul {
        display: flex;
        list-style: none;
        width: 100%;
        justify-content: space-evenly;
        height: 100%;
    }

    .header__nav li {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        transition: all 0.1s linear;
    }

    .header__nav li:hover {
        background-color: rgba(40, 72, 238, 0.5);
    }

    .header__nav a {
        color: white;
        font-size: 0.95rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.6rem;
        transition: all 0.5s ease;
        padding: 0.2rem 0;
    }

    .header__nav li:hover a {
        color: rgb(192, 228, 240);
        /*animation-name:my-animation;*/
        animation-delay: 0.3s;
        animation-duration: 0.4s;
        animation-iteration-count: 2;
        transform: scale(1.3);
        transition: transform 0.3s ease;
    }

    @keyframes my-animation {
        0% {
            transform: scale(1.5, 1.5) rotate(0deg);
        }

        33% {
            transform: scale(1.5, 1.5) rotate(10deg);
        }

        100% {
            transform: scale(1.5, 1.5) rotate(-10deg);
        }
    }

    .icon {
        font-size: 1.1rem;
    }

    .header__actions {
        gap: 1rem;
        display: flex;
        width: 220px;
        justify-content: center;
        align-items: center;
    }

    .btn-subscribe {
        background-color: var(--primary-color);
        color: white;
        border: none;
        padding: 0.8rem 1.8rem;
        border-radius: 50px;
        font-weight: 700;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        white-space: nowrap;
    }

    .btn-subscribe:hover {
        background-color: #1d4ed8;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
    }

    /* Menu Toggle */
    .header__menu-toggle {
        display: none;
        flex-direction: column;
        justify-content: space-between;
        width: 30px;
        height: 21px;
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
    }

    .header__menu-toggle span {
        width: 100%;
        height: 3px;
        background-color: var(--secondary-color);
        border-radius: 3px;
        transition: all 0.3s ease;
    }
</style>
