---
const links = [
    { href: '#h_pf_about-me', label: 'Sobre mí' },
    { href: '#h_pf_projects', label: 'Epiciclos' },
    { href: '#h_pf_skills', label: 'Matemáticas' },
    { href: '#h_pf_certifications', label: 'Certificados' },
    { href: '#h_pf_contact', label: 'Contacto' },
];
---

<header class="header">
    <div class="header__bar">
        <a href="#contenido" class="brand">
            <span class="brand__name">Stive Lamatta</span>
            <span class="brand__role">Estudiante de matemáticas</span>
        </a>

        <nav class="nav" aria-label="Secciones">
            <ul class="nav__list">
                {
                    links.map((link) => (
                        <li>
                            <a href={link.href}>{link.label}</a>
                        </li>
                    ))
                }
            </ul>
        </nav>

        <button class="menu" id="menu-toggle" type="button" aria-expanded="false" aria-controls="menu-movil">
            <span class="menu__bars" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
            </span>
            <span class="menu__label">Menú</span>
        </button>
    </div>

    <div class="drawer" id="menu-movil" hidden>
        <ul>
            {
                links.map((link) => (
                    <li>
                        <a href={link.href} class="drawer__link">
                            {link.label}
                        </a>
                    </li>
                ))
            }
            <li>
                <a class="drawer__link drawer__go" href="https://epy.stivesci.com" target="_blank" rel="noopener noreferrer">
                    Abrir Epiciclos
                    <span class="sr-only"> (se abre en una pestaña nueva)</span>
                </a>
            </li>
        </ul>
    </div>
</header>

<style>
    .header {
        position: sticky;
        top: 0;
        z-index: 40;
        background: var(--plaster);
        border-bottom: 1px solid var(--line);
    }

    .header__bar {
        width: min(var(--wrap), calc(100% - 2 * var(--gutter)));
        margin-inline: auto;
        min-height: var(--header-h);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
    }

    .brand {
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: var(--paper);
        min-height: 2.75rem;
        justify-content: center;
    }

    .brand__name {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.15rem;
        letter-spacing: -0.02em;
        line-height: 1.1;
    }

    .brand__role {
        color: var(--quiet);
        font-size: 0.875rem;
        line-height: 1.3;
    }

    .nav__list {
        display: flex;
        gap: 0.25rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .nav__list a {
        display: inline-flex;
        align-items: center;
        min-height: 2.75rem;
        padding: 0.35rem 0.7rem;
        color: var(--body);
        text-decoration: none;
        font-size: 0.98rem;
    }

    .nav__list a:hover {
        color: var(--trace);
    }

    .nav__list a[aria-current='true'] {
        color: var(--ink);
        background: var(--trace);
    }

    .nav__list a[aria-current='true']:focus-visible {
        outline-color: var(--paper);
    }

    .menu {
        display: none;
        align-items: center;
        gap: 0.6rem;
        min-width: 2.75rem;
        min-height: 2.75rem;
        padding: 0.4rem 0.7rem;
        background: transparent;
        color: var(--paper);
        border: 1px solid var(--line);
        cursor: pointer;
    }

    .menu__bars {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 4px;
        width: 1.1rem;
    }

    .menu__bars span {
        display: block;
        height: 1.5px;
        background: currentcolor;
    }

    .menu__label {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 0.95rem;
    }

    .drawer {
        border-top: 1px solid var(--line);
        background: var(--plaster);
    }

    .drawer ul {
        list-style: none;
        margin: 0;
        padding: 0.5rem var(--gutter) 1rem;
        display: flex;
        flex-direction: column;
    }

    .drawer__link {
        display: flex;
        align-items: center;
        min-height: 2.75rem;
        color: var(--paper);
        text-decoration: none;
        font-size: 1.05rem;
    }

    .drawer__go {
        color: var(--ink);
        background: var(--trace);
        justify-content: center;
        margin-top: 0.5rem;
        font-family: var(--font-display);
        font-weight: 700;
    }

    @media (max-width: 860px) {
        .nav {
            display: none;
        }

        .menu {
            display: inline-flex;
        }

        .brand__role {
            display: none;
        }
    }
</style>

<script>
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('menu-movil');
    const label = toggle?.querySelector('.menu__label');
    const links = document.querySelectorAll('.drawer__link');
    const sections = ['h_pf_about-me', 'h_pf_projects', 'h_pf_skills', 'h_pf_certifications', 'h_pf_contact'].map((id) => document.getElementById(id)).filter((section): section is HTMLElement => section instanceof HTMLElement);

    const setOpen = (open: boolean) => {
        if (!toggle || !menu) return;
        toggle.setAttribute('aria-expanded', String(open));
        menu.hidden = !open;
        if (label) label.textContent = open ? 'Cerrar' : 'Menú';
        toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    };

    if (toggle && menu) {
        toggle.setAttribute('aria-label', 'Abrir menú');
        toggle.addEventListener('click', () => {
            setOpen(toggle.getAttribute('aria-expanded') !== 'true');
        });

        links.forEach((link) => {
            link.addEventListener('click', () => setOpen(false));
        });

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
                setOpen(false);
                toggle.focus();
            }
        });
    }

    const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav__list a'));

    if (sections.length && navLinks.length && 'IntersectionObserver' in window) {
        const mark = (id: string) => {
            navLinks.forEach((link) => {
                const current = link.getAttribute('href') === `#${id}`;
                if (current) link.setAttribute('aria-current', 'true');
                else link.removeAttribute('aria-current');
            });
        };

        const observer = new IntersectionObserver(
            (entries) => {
                const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
                if (visible?.target.id) mark(visible.target.id);
            },
            { rootMargin: '-30% 0px -55% 0px', threshold: [0.1, 0.25, 0.5] }
        );

        sections.forEach((section) => observer.observe(section));
    }
</script>
