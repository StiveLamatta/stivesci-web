---
import recentProy from '../../data/recent.json';
// Limit to 4 articles for the sidebar layout
const recent = recentProy.slice(0, 4);
---

<section class="recentArts">
    <div class="recentArts__header">
        <div class="recentArts__indicator"></div>
        <h2 class="recentArts__title">Artículos Recientes</h2>
    </div>

    <div class="recentArts__list">
        {
            recent.map((art) => (
                <article class="articleCard">
                    <a class="articleCard__link" href={art.link} aria-label={`Leer artículo ${art.title}`}>
                        <div class="articleCard__visual">
                            <img class="articleCard__img" src={art.image} alt={art.title} loading="lazy" />
                            <div class="articleCard__overlay">
                                <span class="articleCard__action">Leer Más</span>
                            </div>
                        </div>
                        <div class="articleCard__content">
                            <h3 class="articleCard__name">{art.title}</h3>
                            <p class="articleCard__desc">{art.description}</p>
                        </div>
                    </a>
                </article>
            ))
        }
    </div>
</section>

<style>
    .recentArts {
        box-sizing: border-box;
        width: 100%;
        position: sticky;
        top: 80px;
        padding: 20px 20px 40px;
        display: flex;
        flex-direction: column;
        gap: 24px;
        max-height: calc(100vh - 100px);
        overflow-y: auto;
        /* Hide scrollbar for a cleaner look */
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

    .recentArts::-webkit-scrollbar {
        display: none;
    }

    .recentArts__header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding-bottom: 8px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .recentArts__indicator {
        width: 8px;
        height: 8px;
        background-color: #ff3e6c; /* distinct accent color for articles */
        border-radius: 50%;
        box-shadow: 0 0 10px #ff3e6c;
        animation: pulseArticle 2s infinite ease-in-out;
    }

    @keyframes pulseArticle {
        0% {
            transform: scale(0.8);
            opacity: 0.5;
        }
        50% {
            transform: scale(1.2);
            opacity: 1;
        }
        100% {
            transform: scale(0.8);
            opacity: 0.5;
        }
    }

    .recentArts__title {
        font-family: 'SN Pro', sans-serif;
        font-size: 20px;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.95);
        margin: 0;
        letter-spacing: -0.02em;
    }

    .recentArts__list {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .articleCard {
        position: relative;
        border-radius: 16px;
        background: rgba(10, 15, 30, 0.4);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        overflow: hidden;
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        transform-origin: center bottom;
    }

    .articleCard:hover {
        transform: translateY(-6px) scale(1.02);
        background: rgba(20, 25, 45, 0.5);
        border-color: rgba(255, 255, 255, 0.15);
        box-shadow:
            0 12px 30px rgba(0, 0, 0, 0.2),
            0 0 0 1px rgba(255, 255, 255, 0.1) inset;
    }

    .articleCard__link {
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
    }

    .articleCard__visual {
        position: relative;
        width: 100%;
        height: 120px;
        background: #000;
        overflow: hidden;
    }

    .articleCard__img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.8;
        transition:
            opacity 0.5s ease,
            transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .articleCard:hover .articleCard__img {
        opacity: 1;
        transform: scale(1.08);
    }

    .articleCard__overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0, 0, 0, 0.8) 0%, transparent 60%);
        display: flex;
        align-items: flex-end;
        justify-content: flex-end;
        padding: 12px;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .articleCard:hover .articleCard__overlay {
        opacity: 1;
    }

    .articleCard__action {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 700;
        color: #fff;
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(4px);
        padding: 4px 10px;
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    .articleCard__content {
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .articleCard__name {
        font-family: 'Lora', serif;
        font-size: 16px;
        font-weight: 600;
        margin: 0;
        color: rgba(255, 255, 255, 0.95);
        line-height: 1.2;
    }

    .articleCard__desc {
        font-size: 13px;
        line-height: 1.5;
        margin: 0;
        color: rgba(255, 255, 255, 0.65);
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
