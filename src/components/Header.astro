---

---

<header class="header">
    <div class="header__top">
        <div class="header__container">
            <div class="header__logo">
                <img src="/logo.jpg" alt="Stive Lamatta" />
            </div>

            <div class="header__brand">
                <h1>Stive Lamatta</h1>
                <p>Data Scientist & Developer</p>
            </div>

            <div class="header__actions">
                <button class="btn-subscribe">¡Suscríbete Gratis!</button>
                <button class="header__menu-toggle" id="menu-toggle" aria-label="Abrir menú">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </div>
    </div>

    <nav class="header__nav" id="main-nav">
        <div class="header__container">
            <div class="header__nav-box">
                <ul>
                    <li>
                        <a href="#w-articulos"><span class="icon">🏠</span> Artículos</a>
                    </li>
                    <li>
                        <a href="#w-proyectos"><span class="icon">📁</span> Proyectos</a>
                    </li>
                    <li>
                        <a href="#w-galeria"><span class="icon">🖼️</span> Galería</a>
                    </li>
                    <li>
                        <a href="#w-biografia"><span class="icon">👤</span> Biografía</a>
                    </li>
                    <li>
                        <a href="#w-contacto"><span class="icon">✉️</span> Contacto</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>

<style>
    .header {
        background-color: var(--bg-color);
        position: sticky;
        top: 0;
        z-index: 100;
        width: 100%;
    }

    .header__top {
        padding: 1.5rem 0;
    }

    .header__container {
        max-width: var(--breakpoint-desktop);
        margin: 0 auto;
        padding: 0 var(--spacing-md);
        display: flex;
        align-items: center;
    }

    .header__logo,
    .header__actions {
        flex: 1;
        display: flex;
        align-items: center;
    }

    .header__actions {
        justify-content: flex-end;
        gap: 1rem;
    }

    .header__logo img {
        width: 55px;
        height: 55px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid var(--primary-color);
        box-shadow: 0 2px 8px rgba(37, 99, 235, 0.15);
    }

    .header__brand {
        flex: 2;
        text-align: center;
    }

    .header__brand h1 {
        font-size: 1.8rem;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        margin: 0;
        color: var(--secondary-color);
    }

    .header__brand p {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: var(--text-light);
        margin-top: 2px;
    }

    .header__nav {
        padding-bottom: 1rem;
        transition: all 0.3s ease;
    }

    .header__nav-box {
        width: 100%;
        border: 1px solid var(--border-color);
        border-radius: var(--border-radius);
        padding: 0.8rem;
        box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.02);
        background-color: white;
    }

    .header__nav ul {
        display: flex;
        justify-content: center;
        list-style: none;
        gap: 3rem;
        margin: 0;
        padding: 0;
    }

    .header__nav a {
        font-family: var(--font-secondary);
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--text-main);
        display: flex;
        align-items: center;
        gap: 0.6rem;
        transition: all 0.2s ease;
        padding: 0.2rem 0;
    }

    .header__nav a:hover,
    .header__nav a.active {
        color: var(--primary-color);
    }

    .icon {
        font-size: 1.1rem;
    }

    .btn-subscribe {
        background-color: var(--primary-color);
        color: white;
        border: none;
        padding: 0.8rem 1.8rem;
        border-radius: 50px;
        font-family: var(--font-secondary);
        font-weight: 700;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        white-space: nowrap;
    }

    .btn-subscribe:hover {
        background-color: #1d4ed8;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
    }

    /* Menu Toggle */
    .header__menu-toggle {
        display: none;
        flex-direction: column;
        justify-content: space-between;
        width: 30px;
        height: 21px;
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
    }

    .header__menu-toggle span {
        width: 100%;
        height: 3px;
        background-color: var(--secondary-color);
        border-radius: 3px;
        transition: all 0.3s ease;
    }

    @media (max-width: 768px) {
        .header__menu-toggle {
            display: flex;
        }

        .header__brand h1 {
            font-size: 1.25rem;
            letter-spacing: 1px;
        }

        .header__brand p {
            font-size: 0.65rem;
        }

        .header__logo img {
            width: 45px;
            height: 45px;
        }

        .header__nav {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            width: 100%;
            background-color: var(--bg-color);
            padding: 1rem;
            border-bottom: 1px solid var(--border-color);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        }

        .header__nav.is-open {
            display: block !important; /* Force visibility when open */
        }

        .header__nav ul {
            flex-direction: column;
            gap: 1rem;
            align-items: flex-start;
        }

        .header__nav-box {
            border: none;
            box-shadow: none;
            padding: 0;
        }

        .btn-subscribe {
            padding: 0.6rem 1rem;
            font-size: 0.75rem;
        }

        /* Toggle Animation */
        .is-active span:nth-child(1) {
            transform: translateY(9px) rotate(45deg);
        }
        .is-active span:nth-child(2) {
            opacity: 0;
        }
        .is-active span:nth-child(3) {
            transform: translateY(-9px) rotate(-45deg);
        }
    }
</style>

<script>
    const menuToggle = document.getElementById('menu-toggle');
    const mainNav = document.getElementById('main-nav');
    const navLinks = document.querySelectorAll('.header__nav a');

    // Toggle Menu
    menuToggle?.addEventListener('click', () => {
        menuToggle.classList.toggle('is-active');
        mainNav?.classList.toggle('is-open');
    });

    // Close menu when clicking a link
    navLinks.forEach((link) => {
        link.addEventListener('click', () => {
            menuToggle?.classList.remove('is-active');
            mainNav?.classList.remove('is-open');
        });
    });

