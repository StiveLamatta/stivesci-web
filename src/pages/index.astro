---
import BaseBlog from '../layout/BaseBlog.astro';
import Profile from '../components/Profile/Profile.astro';
---

<BaseBlog title="Stive Lamatta | Inicio">
    <div class="home">
        <aside class="recentArts"></aside>
        <article class="profiled">
            <Profile />
        </article>
        <aside class="featuredApps"></aside>
    </div>
</BaseBlog>

<style>
    .home {
        display: grid;
        height: 70vh;
        grid-template-columns: 1fr 2fr 1fr;
        grid-template-areas: 'recentArtsAside profileMain featuredAppsAside';
        gap: var(--spacing-md);
    }

    .recentArts {
        grid-area: recentArtsAside;
    }

    .profiled {
        grid-area: profileMain;
    }

    .featuredApps {
        grid-area: featuredAppsAside;
    }

    @media (max-width: 768px) {
        .home {
            grid-template-columns: 1fr;
            grid-template-areas:
                'profileMain'
                'recentArtsAside'
                'featuredAppsAside';
            height: auto;
        }
    }
</style>
